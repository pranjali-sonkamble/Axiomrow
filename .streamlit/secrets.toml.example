# This is what to paste into Streamlit Cloud's dashboard under
# App settings -> Secrets (NOT a file you upload — copy/paste this
# content into the text box there). It's read into st.secrets and
# bridged into os.environ by app.py before the backend is imported.
#
# For LOCAL development, use .env instead (see .env.example) —
# python-dotenv already handles that path via load_dotenv().
#
# This example file has no real values and is safe to commit.
# A real .streamlit/secrets.toml (if you ever create one locally)
# is gitignored — never commit real keys.

LLM_PROVIDER = "groq"
GROQ_API_KEY = "your_groq_api_key_here"
OPENAI_API_KEY = "your_openai_api_key_here"
